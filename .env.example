# fal.ai API key — get yours at https://fal.ai/dashboard
FAL_KEY=your_fal_key_here

# Visoid API key — get at app.visoid.com → Settings → API
# Used for --mode visoid: architecture-tuned rendering, 4K, DAE/GLB 3D model upload
# Docs: https://app.visoid.com/docs
VISOID_KEY=your_visoid_key_here

# Higgsfield — video from renders (Sora 2, Veo 3.1, Kling 3.0)
# Get key at https://higgsfield.ai — optional, only needed for video mode
HIGGSFIELD_KEY=your_higgsfield_key_here
